# Production uses the same-origin Cloudflare Worker endpoint by default.
VITE_OPERATIONS_API_URL=/api/operations

# Only enable this intentionally for isolated frontend development.
VITE_OPERATIONS_USE_MOCKS=false

# These two values are server-side only. For local `npm run dev:ops`, copy this
# file to `.env.local` and fill them in. Never prefix them with VITE_.
OPERATIONS_APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec
OPERATIONS_API_SHARED_SECRET=replace-with-a-long-random-secret
